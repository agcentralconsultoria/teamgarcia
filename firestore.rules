rules_version = '2';
// TeamGarcia — regras de segurança (dados de saúde, LGPD).
// Treinador: quem tem documento em /trainers/{uid} (criado só pelo console/CLI).
// Aluno: só lê e grava os PRÓPRIOS dados, e só enquanto estiver ativo.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTrainer() {
      return signedIn() && exists(/databases/$(database)/documents/trainers/$(request.auth.uid));
    }
    // Funcionário: quem tem documento ativo em /staff/{uid} (criado só pelo treinador dono).
    function isStaff() {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function isTeam() { return isTrainer() || isStaff(); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function studentDoc(uid) { return get(/databases/$(database)/documents/students/$(uid)); }
    function isActiveStudent(uid) {
      return isSelf(uid) && exists(/databases/$(database)/documents/students/$(uid))
        && studentDoc(uid).data.profile.active == true;
    }
    function isAnyActiveStudent() { return signedIn() && isActiveStudent(request.auth.uid); }

    match /trainers/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    // Bibliotecas compartilhadas (exercícios, técnicas, alimentos, questionário, materiais, configurações)
    match /library/{doc} {
      allow read: if isTeam() || isAnyActiveStudent();
      allow write: if isTeam();
    }

    // Cadastro + ficha de treino + dieta do aluno
    match /students/{uid} {
      allow read: if isTeam() || isSelf(uid);
      allow create: if isTeam();
      allow delete: if isTrainer();
      allow update: if isTeam() || (
        isActiveStudent(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profile'])
        && request.resource.data.profile.diff(resource.data.profile).affectedKeys()
             .hasOnly(['name', 'phone', 'birth', 'weight', 'prefs', 'nextCheckin', 'nextMonthly'])
      );
    }

    // Registros do aluno (treinos, água, refeições, peso, check-ins) e fotos
    match /logs/{uid} {
      allow read, create, update: if isTeam() || isActiveStudent(uid);
      allow delete: if isTrainer();
      match /years/{year} {
        allow read, create, update: if isTeam() || isActiveStudent(uid);
        allow delete: if isTrainer();
      }
      match /photos/{photo} {
        allow read: if isTeam() || isActiveStudent(uid);
        allow create: if (isTeam() || isActiveStudent(uid))
          && request.resource.data.data is string
          && request.resource.data.data.size() < 300000;
        allow update: if false;
        allow delete: if isTrainer();
      }
    }

    // Observações pessoais do treinador sobre o aluno (o aluno NÃO vê)
    match /notes/{uid} {
      allow read, write: if isTrainer();
    }

    // Arquivos (anexos) que o treinador manda para o aluno
    match /files/{uid} {
      allow read: if isTeam() || isActiveStudent(uid);
      allow write: if isTeam();
    }

    // Equipe: cadastro dos funcionários e grupos de permissão (só o dono grava; o funcionário lê o próprio)
    match /staff/{uid} {
      allow read: if isTrainer() || isSelf(uid);
      allow write: if isTrainer();
    }

    // Registro de alterações (ninguém edita nem apaga)
    match /audit/{id} {
      allow read: if isTeam();
      allow create: if isTeam() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Comunidade: posts do treinador e dos alunos ativos
    match /community/{id} {
      allow read: if isTeam() || isAnyActiveStudent();
      allow create: if isTeam() || (isAnyActiveStudent() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.team == false && request.resource.data.pinned == false);
      allow update: if isTeam() || (isAnyActiveStudent()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']));
      allow delete: if isTeam() || (isAnyActiveStudent() && resource.data.authorId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
